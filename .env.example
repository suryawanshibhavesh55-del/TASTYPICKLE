# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/tastypickle?retryWrites=true&w=majority

# Cloudinary Credentials (Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Admin Credentials
ADMIN_ID=admin
ADMIN_PASSWORD=your_secure_admin_password

# JWT Secret for Session Authentication
JWT_SECRET=your_jwt_secret_key_here

# Server Port
PORT=5000

# Resend Email Configuration (Server-Side Only)
RESEND_API_KEY=re_your_resend_api_key
OWNER_EMAIL=owner@example.com
RESEND_FROM_EMAIL=TastyPickle Orders <onboarding@resend.dev>

# Razorpay Payment Gateway (Server-Side Only - Never prefix with VITE_ or NEXT_PUBLIC_)
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
